# Copy to ~/.ductor/.env and fill with real values. DO NOT commit .env.
# Scripts read these variables themselves. Secrets are auto-injected into every
# CLI execution (host and Docker). Existing env vars are never overridden.

# ── Telegram (main bot) ────────────────────────────────────
# The main bot token lives in ~/.ductor/config/config.json (telegram_token),
# NOT here. Sub-agent tokens live in ~/.ductor/agents.json. This file is only
# for external INTEGRATION keys.

# ── LLM providers (optional, if used directly by scripts) ──
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Your integrations ──────────────────────────────────────
# Add keys for the connectors you build under tools/integrations/, e.g.:
# MY_POS_TOKEN=
# MY_POS_ACCOUNT=
# MY_REVIEWS_API_KEY=
# MY_SHEET_ID=

# ── Deploy (optional, if you use tools/deploy_tools) ───────
# DEPLOY_HOST=YOUR_SERVER_IP
# DEPLOY_SSH_KEY=/path/to/your/ssh_key
# DEPLOY_URL=https://your-domain/page/
